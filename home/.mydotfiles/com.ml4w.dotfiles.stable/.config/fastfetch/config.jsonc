// fastfetch de Albert (inspirado en Catnap)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.png",
        "type": "kitty-direct",
        "width": 32,
        "height": 16,
        "padding": { "top": 0, "right": 2, "left": 1 }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#34} usuario {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#34}󰇅 equipo  {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "condition": {                                    // Conditional module: only show on non-macOS
                "!system": "macOS"
            },
            "type": "disk",
            "keyIcon": "",
            "key": "│{#34} {icon} edad   {#keys}│",
            // "keyColor": "magenta",
            "folders": "/",                                   // Check root filesystem
            "format": "{create-time:10} [{days} días]"        // Show creation time and age in days
        },        
        {
            "key": "│ {#34}󰅐 activo  {#keys}│",
            "type": "uptime",
            "format": "{?days}{days} d {?}{hours} h {minutes} min"
        },
        {
            "key": "│ {#34}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#34} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#34} wm      {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#34}󰇄 escrit. {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#34} term.   {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#34} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#34}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#34}󰉉 disco   {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#34} memoria {#keys}│",
            "type": "memory"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#34} colores {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
